# Cloudflare Turnstile keys (keep the secret private; never commit real values)
TURNSTILE_SITE_KEY=replace-with-your-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-your-turnstile-secret-key

# Fastmail SMTP app password (create an app password in Fastmail)
SMTP_HOST=smtp.fastmail.com
SMTP_PORT=465
SMTP_USER=hello@toastmasters.net.nz
SMTP_PASS=replace-with-your-fastmail-app-password

# Contact form destination
CONTACT_TO=hello@toastmasters.net.nz

# Webmaster dashboard (generate the password hash; do not use a plain-text password)
ADMIN_USERNAME=webmaster
ADMIN_PASSWORD_HASH=scrypt$replace-with-salt-hex$replace-with-128-character-hash-hex
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
