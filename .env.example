# Cloudflare Turnstile secret key (keep private; never commit the real value)
TURNSTILE_SECRET_KEY=replace-with-your-turnstile-secret-key

# Fastmail SMTP app password (create an app password in Fastmail)
SMTP_HOST=smtp.fastmail.com
SMTP_PORT=465
SMTP_USER=hello@toastmasters.net.nz
SMTP_PASS=replace-with-your-fastmail-app-password

# Contact form destination
CONTACT_TO=hello@toastmasters.net.nz
