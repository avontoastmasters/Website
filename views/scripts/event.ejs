<script>
(() => {
  const button = document.getElementById('share-event');
  const status = document.getElementById('event-share-status');
  if (!button || !status) return;

  button.addEventListener('click', async () => {
    const shareData = {
      title: document.title,
      text: document.querySelector('meta[name="description"]')?.content || document.title,
      url: window.location.href
    };

    try {
      if (navigator.share) {
        await navigator.share(shareData);
        status.textContent = 'Thanks for sharing!';
      } else if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(window.location.href);
        status.textContent = 'Event link copied to your clipboard.';
      } else {
        status.textContent = window.location.href;
      }
    } catch (error) {
      if (error.name !== 'AbortError') status.textContent = 'Unable to share this event right now.';
    }
  });
})();
</script>
