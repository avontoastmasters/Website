<!doctype html><html lang="en-NZ"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><meta name="theme-color" content="#004165"><title><%= maintenance.title %> | Avon Toastmasters</title><link rel="stylesheet" href="/maintenance.css"></head><body class="maintenance-page"><main class="maintenance-card"><a class="maintenance-brand" href="/" aria-label="Avon Toastmasters"><img src="/og-image.png" alt="Avon Toastmasters"></a><p class="maintenance-eyebrow">AVON TOASTMASTERS · CHRISTCHURCH</p><div class="maintenance-symbol" aria-hidden="true"><span></span><span></span><span></span></div><h1><%= maintenance.title %></h1><p class="maintenance-message"><%= maintenance.message %></p><% if (maintenance.endAt) { %><p class="maintenance-return">Expected back: <strong><%= new Intl.DateTimeFormat('en-NZ',{timeZone:'Pacific/Auckland',dateStyle:'long',timeStyle:'short'}).format(new Date(maintenance.endAt)) %> (New Zealand time)</strong></p><% } %><div class="maintenance-divider"></div><p class="maintenance-contact">Need to get in touch? Email <a href="mailto:hello@toastmasters.net.nz">hello@toastmasters.net.nz</a>.</p><p class="maintenance-footer">Thank you for your patience. We look forward to welcoming you back.</p></main></body></html>