<!doctype html>
<html lang="en-NZ"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><meta name="admin-user-key" content="<%= typeof adminUserKey !== 'undefined' ? adminUserKey : 'unknown' %>"><meta name="admin-session-minutes" content="<%= typeof adminSessionMinutes !== 'undefined' ? adminSessionMinutes : 45 %>"><title>User Management | Avon Toastmasters</title><link rel="stylesheet" href="/admin.css"><script src="/admin-session.js" defer></script></head>
<body class="admin-body"><main class="admin-shell"><header class="admin-topbar"><a class="admin-brand" href="/admin"><span class="admin-brand__mark">AVON</span><span><strong>TOASTMASTERS</strong><small>WEBSITE ADMINISTRATION</small></span></a><nav class="admin-nav"><a href="/admin">Dashboard</a><a href="/admin/announcements">Announcements</a><a href="/admin/events">Events</a><a href="/admin/media">Media</a><% if (role === 'administrator') { %><a href="/admin/users">Users</a><a href="/admin/settings">Security</a><% } %><a href="/admin/account">My account</a></nav><div class="admin-topbar__right"><span class="admin-user">Signed in as <strong><%= username %></strong></span><form method="post" action="/admin/logout"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="admin-logout" type="submit">Log out</button></form></div></header>
<section class="admin-heading"><p class="admin-eyebrow">ACCESS CONTROL</p><h1>User management</h1><p class="admin-muted">Create accounts and manage who can access website administration.</p></section>
<% if(saved){ %><p class="admin-alert admin-alert--success">Account changes saved successfully.</p><% } %><% if(error){ %><p class="admin-alert admin-alert--error"><%= error %></p><% } %>
<section class="admin-card"><div class="admin-card__heading"><div><h2>Create an account</h2><p>Editors can manage announcements, events and media. Administrators can also manage users and security.</p></div></div><form method="post" action="/admin/users/create" class="admin-form" data-no-draft><input type="hidden" name="csrf" value="<%= csrf %>"><div class="admin-two-fields"><div><label for="username">Username</label><input id="username" name="username" autocomplete="off" minlength="3" maxlength="40" pattern="[A-Za-z0-9._-]+" required></div><div><label for="email">Email address <span class="admin-muted">(optional)</span></label><input id="email" name="email" type="email" maxlength="254" autocomplete="off"></div><div><label for="role">Account role</label><select id="role" name="role"><option value="editor">Editor</option><option value="administrator">Administrator</option></select></div></div><label for="password">Initial password</label><input id="password" name="password" type="password" autocomplete="new-password" minlength="12" required><small class="admin-help">Minimum 12 characters. Share credentials securely with the account holder.</small><button class="admin-button" type="submit">Create account →</button></form></section>
<section class="admin-card admin-list-card"><div class="admin-card__heading"><div><h2>Existing accounts</h2><p><%= users.length %> account<%= users.length===1?'':'s' %> registered.</p></div></div><div class="admin-user-list"><% users.forEach(user=>{ const protectedUser=String(user.username||'').toLowerCase()==='webmaster'; %><article class="admin-user-row"><div class="admin-user-details"><strong><%= user.username %></strong><% if(user.email){ %><span><%= user.email %></span><% } %><span><%= user.role === 'administrator' ? 'Administrator' : 'Editor' %> · <%= user.enabled ? 'Enabled' : 'Disabled' %><%= protectedUser ? ' · Protected account' : '' %></span><small>Created <%= new Date(user.createdAt).toLocaleString('en-NZ',{dateStyle:'medium',timeStyle:'short'}) %></small></div><div class="admin-user-controls"><form method="post" action="/admin/users/update" class="admin-inline-form"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= user.id %>"><select name="role" aria-label="Role for <%= user.username %>" <%= protectedUser ? 'disabled' : '' %>><option value="editor" <%= user.role==='editor'?'selected':'' %>>Editor</option><option value="administrator" <%= user.role==='administrator'?'selected':'' %>>Administrator</option></select><label class="admin-check"><input type="checkbox" name="enabled" <%= user.enabled?'checked':'' %> <%= protectedUser ? 'disabled' : '' %>> Enabled</label><button class="admin-small-button" type="submit" <%= protectedUser ? 'disabled' : '' %>>Save</button></form><form method="post" action="/admin/users/password" class="admin-inline-form" data-no-draft><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= user.id %>"><input name="newPassword" type="password" minlength="12" autocomplete="new-password" placeholder="New password (12+)" aria-label="New password for <%= user.username %>" required <%= protectedUser ? 'disabled' : '' %>><button class="admin-small-button" type="submit" <%= protectedUser ? 'disabled' : '' %>>Reset password</button></form><% if(user.id !== undefined && !protectedUser){ %><form method="post" action="/admin/users/delete" onsubmit="return confirm('Permanently remove the account <%= user.username %>?');"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= user.id %>"><button class="admin-small-button admin-small-button--danger" type="submit">Remove</button></form><% } %></div></article><% }) %></div></section>
<footer class="admin-page-footer"><a href="/admin">← Dashboard</a><span>Protect the last active administrator account.</span></footer></main></body></html>