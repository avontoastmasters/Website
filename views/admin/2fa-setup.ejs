<!doctype html>
<html lang="en-NZ">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>Set up two-factor authentication | Avon Toastmasters</title>
<link rel="stylesheet" href="/admin.css">
</head>
<body class="admin-body">
<main class="admin-shell admin-shell--login">
<section class="admin-card">
<p class="admin-eyebrow">ACCOUNT SECURITY</p>
<h1>Set up two-factor authentication</h1>
<p class="admin-muted">Protect your Avon Toastmasters administrator account using an authenticator app.</p>

<% if(error){ %><p class="admin-alert admin-alert--error"><%= error %></p><% } %>

<h2>1. Scan this QR code</h2>
<p>Open Google Authenticator, Microsoft Authenticator or 2FAS and scan the code below.</p>

<% if(qrCode){ %>
<img src="<%= qrCode %>" alt="Authenticator setup QR code" width="260" height="260" style="display:block;max-width:100%;height:auto;margin:20px auto">
<% } %>

<h2>2. Or enter the setup key manually</h2>
<p>Use this key if you cannot scan the QR code:</p>
<p style="font-family:monospace;overflow-wrap:anywhere"><strong><%= secret %></strong></p>

<h2>3. Verify your authenticator</h2>
<p>Enter the six-digit code displayed in your authenticator app.</p>

<form method="post" action="/admin/2fa/activate" class="admin-form">
<input type="hidden" name="csrf" value="<%= csrf %>">
<label for="code">Six-digit verification code</label>
<input id="code" name="code" type="text" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required>
<button class="admin-button" type="submit">Verify and enable 2FA →</button>
</form>

<% if(canSkip){ %>
<hr style="margin:25px 0">
<p>You have used <strong><%= skips %> of 3</strong> postponements.</p>
<form method="post" action="/admin/2fa/skip">
<input type="hidden" name="csrf" value="<%= csrf %>">
<button class="admin-button" type="submit">Postpone setup</button>
</form>
<p class="admin-muted">After your third postponement, setup will be compulsory at your next login.</p>
<% } else { %>
<p class="admin-alert admin-alert--error">You have used all three postponements. You must enable two-factor authentication to continue.</p>
<% } %>
</section>
</main>
</body>
</html>
