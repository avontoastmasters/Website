<!doctype html>
<html lang="en-NZ"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><meta name="admin-session-minutes" content="<%= typeof adminSessionMinutes !== 'undefined' ? adminSessionMinutes : 45 %>"><title>Security Settings | Avon Toastmasters</title><link rel="stylesheet" href="/admin.css"><script src="/admin-session.js" defer></script></head>
<body class="admin-body"><main class="admin-shell"><header class="admin-topbar"><a class="admin-brand" href="/admin"><span class="admin-brand__mark">AVON</span><span><strong>TOASTMASTERS</strong><small>WEBSITE ADMINISTRATION</small></span></a><div class="admin-topbar__right"><span class="admin-user">Administrator: <strong><%= username %></strong></span><a class="admin-secondary" href="/admin">Dashboard</a><form method="post" action="/admin/logout"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="admin-logout">Log out</button></form></div></header>
<section class="admin-heading"><p class="admin-eyebrow">SECURITY</p><h1>Security settings</h1><p class="admin-muted">Choose how long an administrator or editor can remain inactive before being signed out.</p></section>
<% if(saved){ %><p class="admin-alert admin-alert--success">Security settings saved. The new timeout applies to active sessions on their next activity.</p><% } %>
<section class="admin-card admin-narrow-card"><div class="admin-card__heading"><div><h2>Inactivity timeout</h2><p>Sessions expire after the selected period without activity.</p></div></div><form method="post" action="/admin/settings" class="admin-form"><input type="hidden" name="csrf" value="<%= csrf %>"><label for="sessionMinutes">Sign out after</label><select id="sessionMinutes" name="sessionMinutes"><option value="30" <%= settings.sessionMinutes===30?'selected':'' %>>30 minutes</option><option value="45" <%= settings.sessionMinutes===45?'selected':'' %>>45 minutes (recommended)</option><option value="60" <%= settings.sessionMinutes===60?'selected':'' %>>60 minutes</option></select><small class="admin-help">A warning appears two minutes before expiry. Choosing “Stay signed in” resets the timer.</small><button class="admin-button" type="submit">Save security settings →</button></form></section>
<footer class="admin-page-footer"><a href="/admin">← Dashboard</a><span>Avon Toastmasters · Security</span></footer></main></body></html>