<!doctype html>
<html lang="en-NZ"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><meta name="admin-user-key" content="<%= typeof adminUserKey !== 'undefined' ? adminUserKey : 'unknown' %>"><meta name="admin-session-minutes" content="<%= typeof adminSessionMinutes !== 'undefined' ? adminSessionMinutes : 45 %>"><meta name="theme-color" content="#004165"><title>Admin Dashboard | Avon Toastmasters</title><link rel="stylesheet" href="/admin.css"><script src="/admin-session.js" defer></script></head>
<body class="admin-body"><main class="admin-shell">
<header class="admin-topbar"><a class="admin-brand" href="/admin"><span class="admin-brand__mark">AVON</span><span><strong>TOASTMASTERS</strong><small>WEBSITE ADMINISTRATION</small></span></a><nav class="admin-nav"><a href="/admin">Dashboard</a><a href="/admin/announcements">Announcements</a><a href="/admin/events">Events</a><a href="/admin/media">Media</a><% if (role === 'administrator') { %><a href="/admin/users">Users</a><a href="/admin/settings">Security</a><% } %><a href="/admin/account">My account</a></nav><div class="admin-topbar__right"><span class="admin-user">Signed in as <strong><%= username %></strong></span><form method="post" action="/admin/logout"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="admin-logout" type="submit">Log out</button></form></div></header>
<section class="admin-heading"><p class="admin-eyebrow">AVON TOASTMASTERS · WEBSITE</p><h1>Welcome to your dashboard</h1><p class="admin-muted">Manage website content, events and media from one place.</p></section>
<section class="admin-dashboard-grid">
<a class="admin-dashboard-card" href="/admin/announcements"><span class="admin-dashboard-icon">01</span><h2>Announcements</h2><p>Create, schedule and update website banners.</p><strong><%= announcementCount %> saved announcements →</strong></a>
<a class="admin-dashboard-card" href="/admin/events"><span class="admin-dashboard-icon">02</span><h2>Events</h2><p>Publish open houses, competitions, workshops and club events.</p><strong><%= eventCount %> saved events →</strong></a>
<a class="admin-dashboard-card" href="/admin/media"><span class="admin-dashboard-icon">03</span><h2>Media library</h2><p>Upload, organise and reuse website images.</p><strong><%= mediaCount %> images stored →</strong></a>
<% if(role === 'administrator'){ %><a class="admin-dashboard-card" href="/admin/users"><span class="admin-dashboard-icon">04</span><h2>User management</h2><p>Create accounts, assign roles and manage access.</p><strong><%= userCount %> accounts →</strong></a><a class="admin-dashboard-card" href="/admin/settings"><span class="admin-dashboard-icon">05</span><h2>Security settings</h2><p>Configure your admin inactivity timeout.</p><strong>Review security →</strong></a><% } %>
<a class="admin-dashboard-card" href="/admin/account"><span class="admin-dashboard-icon">06</span><h2>My account</h2><p>Change your password and protect your account.</p><strong>Account security →</strong></a>
</section>
<footer class="admin-page-footer"><a href="/">← Return to Avon Toastmasters</a><span>Avon Toastmasters · Website administration</span></footer></main></body></html>