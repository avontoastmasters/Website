<!doctype html>
<html lang="en-NZ"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>My Account | Avon Toastmasters</title><link rel="stylesheet" href="/admin.css"><script src="/admin-session.js" defer></script></head>
<body class="admin-body"><main class="admin-shell"><header class="admin-topbar"><a class="admin-brand" href="/admin"><span class="admin-brand__mark">AVON</span><span><strong>TOASTMASTERS</strong><small>WEBSITE ADMINISTRATION</small></span></a><div class="admin-topbar__right"><span class="admin-user"><strong><%= username %></strong> · <%= role %></span><a class="admin-secondary" href="/admin">Dashboard</a><form method="post" action="/admin/logout"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="admin-logout">Log out</button></form></div></header>
<section class="admin-heading"><p class="admin-eyebrow">ACCOUNT SECURITY</p><h1>My account</h1><p class="admin-muted">Change your password. Your current password is required to confirm the change.</p></section>
<% if(error){ %><p class="admin-alert admin-alert--error"><%= error %></p><% } %>
<section class="admin-card admin-narrow-card"><div class="admin-card__heading"><div><h2>Change password</h2><p>Use a unique password of at least 12 characters.</p></div></div><form method="post" action="/admin/account/password" class="admin-form" data-no-draft><input type="hidden" name="csrf" value="<%= csrf %>"><label for="currentPassword">Current password</label><input id="currentPassword" name="currentPassword" type="password" autocomplete="current-password" required><label for="newPassword">New password</label><input id="newPassword" name="newPassword" type="password" autocomplete="new-password" minlength="12" required><label for="confirmPassword">Confirm new password</label><input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="12" required><button class="admin-button" type="submit">Update password →</button></form></section>
<footer class="admin-page-footer"><a href="/admin">← Dashboard</a><span>Changing your password signs you out of all sessions.</span></footer></main></body></html>