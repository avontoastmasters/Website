<!doctype html>
<html lang="en-NZ">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<meta name="admin-user-key" content="<%= typeof adminUserKey !== 'undefined' ? adminUserKey : 'unknown' %>">
<meta name="admin-session-minutes" content="<%= typeof adminSessionMinutes !== 'undefined' ? adminSessionMinutes : 45 %>">
<title>My Account | Avon Toastmasters</title>
<link rel="stylesheet" href="/admin.css">
<script src="/admin-session.js" defer></script>
</head>
<body class="admin-body">
<main class="admin-shell">
<header class="admin-topbar">
<a class="admin-brand" href="/admin">
<span class="admin-brand__mark">AVON</span>
<span><strong>TOASTMASTERS</strong><small>WEBSITE ADMINISTRATION</small></span>
</a>
<nav class="admin-nav">
<a href="/admin">Dashboard</a>
<a href="/admin/announcements">Announcements</a>
<a href="/admin/events">Events</a>
<a href="/admin/media">Media</a>
<% if (role === 'administrator') { %>
<a href="/admin/users">Users</a>
<a href="/admin/settings">Security</a>
<% } %>
<a href="/admin/account">My account</a>
</nav>
<div class="admin-topbar__right">
<span class="admin-user">Signed in as <strong><%= username %></strong></span>
<form method="post" action="/admin/logout">
<input type="hidden" name="csrf" value="<%= csrf %>">
<button class="admin-logout" type="submit">Log out</button>
</form>
</div>
</header>

<section class="admin-heading">
<p class="admin-eyebrow">ACCOUNT SECURITY</p>
<h1>My account</h1>
<p class="admin-muted">Manage your password and authenticator security settings.</p>
</section>

<% if (error) { %>
<p class="admin-alert admin-alert--error"><%= error %></p>
<% } %>

<% if (saved === 'password') { %>
<p class="admin-alert">Your password has been updated.</p>
<% } %>

<section class="admin-card admin-narrow-card">
<div class="admin-card__heading">
<div>
<h2>Authenticator two-factor authentication</h2>
<p>Add a verification code from an authenticator app whenever you sign in.</p>
</div>
</div>

<% if (twoFactorEnabled) { %>
<p><strong>Status:</strong> Enabled</p>
<p><strong>Unused recovery codes:</strong> <%= recoveryCount %></p>
<p class="admin-muted">Keep your recovery codes somewhere secure. Each code can only be used once.</p>

<hr>

<h3>Generate new recovery codes</h3>
<p>This replaces all existing recovery codes. You must confirm your password and verify your identity below.</p>

<form method="post" action="/admin/account/2fa/recovery" class="admin-form" data-no-draft>
<input type="hidden" name="csrf" value="<%= csrf %>">

<label for="recoveryCurrentPassword">Current password</label>
<input id="recoveryCurrentPassword" name="currentPassword" type="password" autocomplete="current-password" required>

<label for="recoveryAuthenticatorCode">Authenticator code</label>
<input id="recoveryAuthenticatorCode" name="authenticatorCode" type="text" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" placeholder="6-digit code">

<label for="recoveryBackupCode">Or use a recovery code</label>
<input id="recoveryBackupCode" name="recoveryCode" type="text" autocomplete="off" placeholder="XXXX-XXXX-XXXX-XXXX">

<button class="admin-button" type="submit">Generate new recovery codes →</button>
</form>

<hr>

<h3>Disable authenticator authentication</h3>
<p>Disabling 2FA removes your authenticator and recovery codes. You will be signed out and asked to set it up again at your next sign-in.</p>

<form method="post" action="/admin/account/2fa/disable" class="admin-form" data-no-draft>
<input type="hidden" name="csrf" value="<%= csrf %>">

<label for="disableCurrentPassword">Current password</label>
<input id="disableCurrentPassword" name="currentPassword" type="password" autocomplete="current-password" required>

<label for="disableAuthenticatorCode">Authenticator code</label>
<input id="disableAuthenticatorCode" name="authenticatorCode" type="text" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" placeholder="6-digit code">

<label for="disableRecoveryCode">Or use a recovery code</label>
<input id="disableRecoveryCode" name="recoveryCode" type="text" autocomplete="off" placeholder="XXXX-XXXX-XXXX-XXXX">

<button class="admin-button" type="submit">Disable two-factor authentication</button>
</form>

<% } else { %>
<p><strong>Status:</strong> Not enabled</p>
<p class="admin-muted">You will be prompted to configure authenticator authentication the next time you sign in, or you can set it up now.</p>
<a class="admin-button" href="/admin/2fa/setup">Set up authenticator →</a>
<% } %>
</section>

<section class="admin-card admin-narrow-card">
<div class="admin-card__heading">
<div>
<h2>Change password</h2>
<p>Use a unique password of at least 12 characters.</p>
</div>
</div>

<form method="post" action="/admin/account/password" class="admin-form" data-no-draft>
<input type="hidden" name="csrf" value="<%= csrf %>">

<label for="currentPassword">Current password</label>
<input id="currentPassword" name="currentPassword" type="password" autocomplete="current-password" required>

<label for="newPassword">New password</label>
<input id="newPassword" name="newPassword" type="password" autocomplete="new-password" minlength="12" required>

<label for="confirmPassword">Confirm new password</label>
<input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="12" required>

<button class="admin-button" type="submit">Update password →</button>
</form>
</section>

<footer class="admin-page-footer">
<a href="/admin">← Dashboard</a>
<span>Changing your password signs you out of all sessions.</span>
</footer>
</main>
</body>
</html>
