<!doctype html>
<html lang="en-NZ"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><meta name="admin-session-minutes" content="<%= typeof adminSessionMinutes !== 'undefined' ? adminSessionMinutes : 45 %>"><meta name="theme-color" content="#004165"><title>Media Library | Avon Toastmasters</title><link rel="stylesheet" href="/admin.css"><script src="/admin-session.js" defer></script></head>
<body class="admin-body"><main class="admin-shell">
<header class="admin-topbar"><a class="admin-brand" href="/admin"><span class="admin-brand__mark">AVON</span><span><strong>TOASTMASTERS</strong><small>WEBSITE ADMINISTRATION</small></span></a><nav class="admin-nav"><a href="/admin">Dashboard</a><a href="/admin/announcements">Announcements</a><a href="/admin/events">Events</a><a href="/admin/media">Media</a><% if (typeof role !== 'undefined' && role === 'administrator') { %><a href="/admin/users">Users</a><a href="/admin/settings">Security</a><% } %><a href="/admin/account">My account</a></nav><div class="admin-topbar__right"><span class="admin-user">Signed in as <strong><%= username %></strong></span><form method="post" action="/admin/logout"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="admin-logout" type="submit">Log out</button></form></div></header>
<section class="admin-heading"><p class="admin-eyebrow">WEBSITE CONTENT</p><h1>Media library</h1><p class="admin-muted">Upload images once and reuse them anywhere on the Avon Toastmasters website. Select any image to copy its direct URL or HTML embed code.</p></section>
<section class="admin-card admin-media-upload"><div class="admin-card__heading"><div><h2>Upload an image</h2><p>JPEG, PNG, WebP, AVIF or HEIC · Maximum original size 8 MB</p></div></div><form class="admin-media-upload__form" method="post" action="/admin/media/upload" enctype="multipart/form-data"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="file" name="mediaImage" id="mediaImage" accept="image/jpeg,image/png,image/webp,image/avif,image/heic,image/heif,.heic,.heif" required><button class="admin-button" type="submit">Upload &amp; optimise image →</button></form><p class="admin-help">Images are automatically resized to fit within 2000 × 2000 pixels and converted to WebP for faster loading. Original files are not retained.</p><% if(uploaded){ %><p class="admin-alert admin-alert--success">Your image has been uploaded and is ready to use.</p><% } %></section>
<section class="admin-card admin-media-library"><div class="admin-card__heading"><div><h2>Your images</h2><p><%= files.length %> image<%= files.length===1?'':'s' %> stored on this website</p></div><input id="mediaSearch" type="search" placeholder="Search images…" aria-label="Search images"></div>
<% if(!files.length){ %><p class="admin-empty">No images uploaded yet. Upload your first image above.</p><% } else { %><div class="admin-media-grid" id="mediaGrid"><% files.forEach(file=>{ const fullUrl='https://toastmasters.net.nz'+file.url; %><article class="admin-media-item" data-search="<%= file.filename.toLowerCase() %>"><button class="admin-media-thumb" type="button" data-url="<%= fullUrl %>" data-filename="<%= file.filename %>" aria-label="View image details for <%= file.filename %>"><img src="<%= file.url %>" alt="" loading="lazy"><span>View image &amp; copy URL</span></button><div class="admin-media-item__info"><strong><%= file.filename %></strong><small><%= (file.bytes/1024).toFixed(1) %> KB · <%= new Date(file.modified).toLocaleDateString('en-NZ') %></small></div><form method="post" action="/admin/media/delete" onsubmit="return confirm('Permanently delete this image? Any pages using it will show a broken image.');"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="filename" value="<%= file.filename %>"><button class="admin-small-button admin-small-button--danger" type="submit">Delete</button></form></article><% }) %></div><% } %></section>
<footer class="admin-page-footer"><a href="/admin">← Return to dashboard</a><a href="/" target="_blank" rel="noopener">View website ↗</a></footer></main>
<dialog class="admin-media-dialog" id="mediaDialog"><form method="dialog" class="admin-media-dialog__close"><button aria-label="Close">×</button></form><img id="mediaDialogImage" alt="Selected image preview"><h2 id="mediaDialogName">Image details</h2><label for="mediaDirectUrl">Direct image URL</label><div class="admin-copy-row"><input id="mediaDirectUrl" readonly><button type="button" data-copy="mediaDirectUrl">Copy URL</button></div><label for="mediaHtml">HTML image code</label><div class="admin-copy-row"><textarea id="mediaHtml" readonly rows="3"></textarea><button type="button" data-copy="mediaHtml">Copy HTML</button></div><p class="admin-help">Use the direct URL in page content, announcements, or HTML. The full HTTPS address works outside this website too.</p></dialog>
<script>(()=>{const dialog=document.getElementById('mediaDialog');document.querySelectorAll('.admin-media-thumb').forEach(button=>button.addEventListener('click',()=>{const url=button.dataset.url;document.getElementById('mediaDialogImage').src=url;document.getElementById('mediaDialogName').textContent=button.dataset.filename;document.getElementById('mediaDirectUrl').value=url;document.getElementById('mediaHtml').value='<img src="'+url+'" alt="">';dialog.showModal()}));document.querySelectorAll('[data-copy]').forEach(button=>button.addEventListener('click',async()=>{const input=document.getElementById(button.dataset.copy);try{await navigator.clipboard.writeText(input.value)}catch{input.select();document.execCommand('copy')}button.textContent='Copied!';setTimeout(()=>button.textContent=button.dataset.copy==='mediaDirectUrl'?'Copy URL':'Copy HTML',1400)}));document.getElementById('mediaSearch').addEventListener('input',event=>{const term=event.target.value.toLowerCase();document.querySelectorAll('.admin-media-item').forEach(item=>item.hidden=!item.dataset.search.includes(term))});dialog.addEventListener('click',event=>{if(event.target===dialog)dialog.close()})})();</script></body></html>