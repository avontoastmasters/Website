<!doctype html>
<html lang="en-NZ">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <meta name="theme-color" content="#004165">
  <title>Webmaster Login | Avon Toastmasters</title>
  <link rel="stylesheet" href="/admin.css">
</head>
<body class="admin-body">
  <main class="admin-shell admin-shell--login">
    <a class="admin-brand" href="/" aria-label="Avon Toastmasters home">
      <span class="admin-brand__mark">AVON</span>
      <span><strong>TOASTMASTERS</strong><small>WEBMASTER DASHBOARD</small></span>
    </a>
    <section class="admin-card">
      <p class="admin-eyebrow">WEBSITE ADMINISTRATION</p>
      <h1>Welcome back</h1>
      <p class="admin-muted">Sign in to manage the Avon Toastmasters announcement banner.</p>
      <% if (error) { %><p class="admin-alert admin-alert--error" role="alert"><%= error %></p><% } %>
      <form method="post" action="/admin/login" class="admin-form">
        <label for="username">Username</label>
        <input id="username" name="username" type="text" autocomplete="username" value="<%= username %>" required maxlength="80">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required>
        <button class="admin-button" type="submit">Sign in <span aria-hidden="true">→</span></button>
      </form>
      <a class="admin-back-link" href="/">← Back to website</a>
    </section>
    <p class="admin-footer">Avon Toastmasters · Christchurch, New Zealand</p>
  </main>
</body>
</html>