<!doctype html>
<html lang="en-NZ"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><meta name="theme-color" content="#004165"><title>Webmaster Dashboard | Avon Toastmasters</title><link rel="stylesheet" href="/admin.css"><script src="/admin.js" defer></script></head>
<body class="admin-body"><main class="admin-shell">
<header class="admin-topbar"><a class="admin-brand" href="/"><span class="admin-brand__mark">AVON</span><span><strong>TOASTMASTERS</strong><small>WEBMASTER DASHBOARD</small></span></a><div class="admin-topbar__right"><span class="admin-user">Signed in as <strong><%= username %></strong></span><form method="post" action="/admin/logout"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="admin-logout" type="submit">Log out</button></form></div></header>
<section class="admin-heading"><p class="admin-eyebrow">AVON TOASTMASTERS · WEBSITE</p><h1>Announcement manager</h1><p class="admin-muted">Create and schedule website banners. Different announcements can be scheduled, but overlapping times are not allowed.</p></section>
<% if (saved) { %><p class="admin-alert admin-alert--success" role="status">Changes saved successfully.</p><% } %><% if (error) { %><p class="admin-alert admin-alert--error" role="alert"><%= error %></p><% } %>
<div class="admin-grid"><section class="admin-card"><div class="admin-card__heading"><div><h2><%= editing ? 'Edit announcement' : 'Create announcement' %></h2><p>This banner appears during its scheduled start and end times.</p></div><span class="admin-lock">PRIVATE</span></div>
<form method="post" action="/admin/save" class="admin-form" id="announcement-form"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= editing ? editing.id : '' %>">
<label class="admin-toggle"><input type="checkbox" name="enabled" id="enabled" <%= editing ? (editing.enabled ? 'checked' : '') : 'checked' %>><span><strong>Publish this announcement</strong><small>This announcement will publish at its scheduled start time. Overlapping schedules are blocked.</small></span></label>
<label for="type">Announcement style</label><select id="type" name="type"><option value="general" <%= editing && editing.type==='general'?'selected':'' %>>General – Loyal Blue</option><option value="important" <%= editing && editing.type==='important'?'selected':'' %>>Important – Happy Yellow</option><option value="event" <%= editing && editing.type==='event'?'selected':'' %>>Event – True Maroon</option><option value="urgent" <%= editing && editing.type==='urgent'?'selected':'' %>>Urgent – Red</option></select>
<label for="title">Heading</label><input id="title" name="title" maxlength="100" required value="<%= editing ? editing.title : '' %>" placeholder="e.g. Important meeting update">
<label for="message">Message</label><textarea id="message" name="message" rows="3" maxlength="500" required placeholder="Write a short message for website visitors..."><%= editing ? editing.message : '' %></textarea><small class="admin-help">Maximum 500 characters.</small>
<div class="admin-two-fields"><div><label for="buttonText">Button text <span>(optional)</span></label><input id="buttonText" name="buttonText" maxlength="40" value="<%= editing ? editing.buttonText : '' %>" placeholder="Find out more"></div><div><label for="buttonLink">Button link <span>(optional)</span></label><input id="buttonLink" name="buttonLink" maxlength="500" value="<%= editing ? editing.buttonLink : '' %>" placeholder="/meetings.html"></div></div>
<div class="admin-schedule-fields"><fieldset><legend>When should it appear?</legend><div class="admin-two-fields"><div><label for="startDate">Start date <span>(leave blank for today)</span></label><input id="startDate" name="startDate" type="date" value="<%= editing ? editing.startDate : '' %>"></div><div><label for="startTime">Start time <span>(leave blank for now)</span></label><input id="startTime" name="startTime" type="time" value="<%= editing ? editing.startTime : '' %>"></div></div></fieldset><fieldset><legend>When should it disappear?</legend><div class="admin-two-fields"><div><label for="endDate">End date <span>(optional)</span></label><input id="endDate" name="endDate" type="date" value="<%= editing ? editing.endDate : '' %>"></div><div><label for="endTime">End time <span>(optional)</span></label><input id="endTime" name="endTime" type="time" value="<%= editing ? editing.endTime : '' %>"></div></div></fieldset></div><small class="admin-help">All dates and times use New Zealand local time. No start date means today and no start time means immediately. If an end date is entered without a time, it ends at 11:59 pm. Leave both end fields blank for no expiry.</small>
<div class="admin-actions"><button class="admin-button" type="submit"><%= editing ? 'Save changes' : 'Save announcement' %> →</button><% if(editing){ %><a class="admin-secondary" href="/admin">Cancel edit</a><% } %><a class="admin-secondary" href="/" target="_blank" rel="noopener noreferrer">View website ↗</a></div></form></section>
<aside class="admin-preview-column"><section class="admin-card admin-preview-card"><p class="admin-eyebrow">LIVE PREVIEW</p><h2>How it will look</h2><p class="admin-muted">Preview updates as you type. Save to publish.</p><div id="announcement-preview" class="admin-preview site-announcement--general"><span id="preview-label" class="admin-preview__label">ANNOUNCEMENT</span><strong id="preview-title"><%= editing ? editing.title : 'Your announcement heading' %></strong><span id="preview-message"><%= editing ? editing.message : 'Your announcement message will appear here.' %></span><span id="preview-button" class="admin-preview__button" hidden>Find out more →</span></div><p class="admin-preview-note">The banner appears below the main navigation.</p></section></aside></div>
<section class="admin-card admin-list-card">
<div class="admin-card__heading"><div><p class="admin-eyebrow">CONTENT LIBRARY</p><h2>Your announcements</h2><p>Manage live and upcoming website banners. Expired and disabled announcements are kept below so you can edit and reuse them.</p></div></div>
<% const isExpired = item => { const endAt = item.endDate ? item.endDate + 'T' + (item.endTime || '23:59') : ''; return Boolean(endAt && endAt <= nowNZ); }; const currentAnnouncements = announcements.filter(item => item.enabled && !isExpired(item)); const archivedAnnouncements = announcements.filter(item => !item.enabled || isExpired(item)); %>
<div class="admin-announcement-group"><div class="admin-announcement-group__heading"><h3>Live &amp; scheduled</h3><span><%= currentAnnouncements.length %></span></div>
<% if (!currentAnnouncements.length) { %><p class="admin-empty">No live or scheduled announcements. Create one above or reuse an item from your archive.</p><% } else { %><div class="admin-announcements"><% currentAnnouncements.forEach(item => { const startsAt = item.startDate ? item.startDate + 'T' + (item.startTime || '00:00') : '0000-01-01T00:00'; const endsAt = item.endDate ? item.endDate + 'T' + (item.endTime || '23:59') : ''; const status = startsAt > nowNZ ? 'Scheduled' : 'Active'; %><article class="admin-announcement-row admin-announcement-card"><div class="admin-announcement-copy"><span class="admin-status admin-status--<%= status.toLowerCase() %>"><%= status %></span><h3><%= item.title %></h3><p><%= item.message %></p><small>Starts: <%= item.startDate || 'Today' %> at <%= item.startTime || 'Immediately' %> NZ time · Ends: <%= item.endDate ? item.endDate + ' at ' + (item.endTime || '23:59') : 'No expiry' %></small></div><div class="admin-row-actions"><a class="admin-secondary" href="/admin?edit=<%= encodeURIComponent(item.id) %>">Edit</a><form method="post" action="/admin/delete" onsubmit="return confirm('Permanently delete this announcement? This cannot be undone.');"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= item.id %>"><button class="admin-small-button admin-small-button--danger" type="submit">Delete</button></form><form method="post" action="/admin/toggle"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= item.id %>"><input type="hidden" name="enabled" value=""><button class="admin-small-button" type="submit">Disable</button></form></div></article><% }) %></div><% } %></div>
<div class="admin-announcement-group admin-announcement-group--archive"><div class="admin-announcement-group__heading"><div><h3>Expired &amp; disabled</h3><p>These announcements are saved and can be edited and published again whenever you need them.</p></div><span><%= archivedAnnouncements.length %></span></div>
<% if (!archivedAnnouncements.length) { %><p class="admin-empty">Nothing here yet. Announcements will move here automatically when they expire or when you disable them.</p><% } else { %><div class="admin-announcements"><% archivedAnnouncements.forEach(item => { const endsAt = item.endDate ? item.endDate + 'T' + (item.endTime || '23:59') : ''; const status = endsAt && endsAt <= nowNZ ? 'Expired' : 'Disabled'; %><article class="admin-announcement-row admin-announcement-card admin-announcement-card--archived"><div class="admin-announcement-copy"><span class="admin-status admin-status--<%= status.toLowerCase() %>"><%= status %></span><h3><%= item.title %></h3><p><%= item.message %></p><small>Starts: <%= item.startDate || 'Today' %> at <%= item.startTime || 'Immediately' %> NZ time · Ends: <%= item.endDate ? item.endDate + ' at ' + (item.endTime || '23:59') : 'No expiry' %></small></div><div class="admin-row-actions"><a class="admin-secondary" href="/admin?edit=<%= encodeURIComponent(item.id) %>">Edit / reuse</a><form method="post" action="/admin/delete" onsubmit="return confirm('Permanently delete this announcement? This cannot be undone.');"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= item.id %>"><button class="admin-small-button admin-small-button--danger" type="submit">Delete</button></form><% if (!status || status !== 'Expired') { %><form method="post" action="/admin/toggle"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= item.id %>"><input type="hidden" name="enabled" value="on"><button class="admin-small-button" type="submit">Publish</button></form><% } %></div></article><% }) %></div><% } %></div>
</section>
<footer class="admin-page-footer"><a href="/">← Return to Avon Toastmasters</a><span>Avon Toastmasters · Webmaster</span></footer></main></body></html>