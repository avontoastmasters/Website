<!doctype html>
<html lang="en-NZ">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <meta name="theme-color" content="#004165">
  <title>Webmaster Dashboard | Avon Toastmasters</title>
  <link rel="stylesheet" href="/admin.css">
  <script src="/admin.js" defer></script>
</head>
<body class="admin-body">
  <main class="admin-shell">
    <header class="admin-topbar">
      <a class="admin-brand" href="/">
        <span class="admin-brand__mark">AVON</span>
        <span><strong>TOASTMASTERS</strong><small>WEBMASTER DASHBOARD</small></span>
      </a>
      <div class="admin-topbar__right">
        <span class="admin-user">Signed in as <strong><%= username %></strong></span>
        <form method="post" action="/admin/logout">
          <input type="hidden" name="csrf" value="<%= csrf %>">
          <button class="admin-logout" type="submit">Log out</button>
        </form>
      </div>
    </header>

    <section class="admin-heading">
      <p class="admin-eyebrow">AVON TOASTMASTERS · WEBSITE</p>
      <h1>Announcement banner</h1>
      <p class="admin-muted">Create a short update for visitors. Save it here and it will appear across the website.</p>
    </section>

    <% if (saved) { %><p class="admin-alert admin-alert--success" role="status">Your announcement settings have been saved.</p><% } %>

    <div class="admin-grid">
      <section class="admin-card">
        <div class="admin-card__heading">
          <div><h2>Banner details</h2><p>Only one announcement can be shown at a time.</p></div>
          <span class="admin-lock">PRIVATE</span>
        </div>
        <form method="post" action="/admin/save" class="admin-form" id="announcement-form">
          <input type="hidden" name="csrf" value="<%= csrf %>">
          <label class="admin-toggle">
            <input type="checkbox" name="enabled" id="enabled" <%= announcement.enabled ? 'checked' : '' %>>
            <span><strong>Show announcement on the website</strong><small>Turn this off to hide the banner without deleting its content.</small></span>
          </label>

          <label for="type">Announcement style</label>
          <select id="type" name="type">
            <option value="general" <%= announcement.type === 'general' ? 'selected' : '' %>>General – Loyal Blue</option>
            <option value="important" <%= announcement.type === 'important' ? 'selected' : '' %>>Important – Happy Yellow</option>
            <option value="event" <%= announcement.type === 'event' ? 'selected' : '' %>>Event – True Maroon</option>
            <option value="urgent" <%= announcement.type === 'urgent' ? 'selected' : '' %>>Urgent – Red</option>
          </select>

          <label for="title">Heading</label>
          <input id="title" name="title" type="text" maxlength="100" required value="<%= announcement.title || '' %>" placeholder="e.g. Important meeting update">

          <label for="message">Message</label>
          <textarea id="message" name="message" rows="3" maxlength="500" required placeholder="Write a short message for website visitors..."><%= announcement.message || '' %></textarea>
          <small class="admin-help">Keep it brief and clear. Maximum 500 characters.</small>

          <div class="admin-two-fields">
            <div><label for="buttonText">Button text <span>(optional)</span></label><input id="buttonText" name="buttonText" type="text" maxlength="40" value="<%= announcement.buttonText || '' %>" placeholder="Find out more"></div>
            <div><label for="buttonLink">Button link <span>(optional)</span></label><input id="buttonLink" name="buttonLink" type="text" maxlength="500" value="<%= announcement.buttonLink || '' %>" placeholder="/meetings.html"></div>
          </div>

          <div class="admin-two-fields">
            <div><label for="startDate">Start date <span>(optional)</span></label><input id="startDate" name="startDate" type="date" value="<%= announcement.startDate || '' %>"></div>
            <div><label for="endDate">Expiry date <span>(optional)</span></label><input id="endDate" name="endDate" type="date" value="<%= announcement.endDate || '' %>"></div>
          </div>
          <small class="admin-help">Dates use New Zealand time. Leave blank to show it immediately or until you switch it off.</small>

          <div class="admin-actions">
            <button class="admin-button" type="submit">Save announcement <span aria-hidden="true">→</span></button>
            <a class="admin-secondary" href="/" target="_blank" rel="noopener noreferrer">View website ↗</a>
          </div>
        </form>
      </section>

      <aside class="admin-preview-column">
        <section class="admin-card admin-preview-card">
          <p class="admin-eyebrow">LIVE PREVIEW</p>
          <h2>How it will look</h2>
          <p class="admin-muted">This preview updates as you edit the fields. Save to publish it.</p>
          <div id="announcement-preview" class="admin-preview site-announcement--general">
            <span id="preview-label" class="admin-preview__label">ANNOUNCEMENT</span>
            <strong id="preview-title"><%= announcement.title || 'Your announcement heading' %></strong>
            <span id="preview-message"><%= announcement.message || 'Your announcement message will appear here.' %></span>
            <span id="preview-button" class="admin-preview__button" <%= announcement.buttonText ? '' : 'hidden' %>><%= announcement.buttonText || 'Find out more' %> →</span>
          </div>
          <p class="admin-preview-note">The banner appears underneath the main navigation on every page.</p>
        </section>
        <section class="admin-tip">
          <strong>Quick tip</strong>
          <p>Use the banner for important changes, upcoming events or special club news. Switch it off when the announcement is no longer relevant.</p>
        </section>
      </aside>
    </div>
    <footer class="admin-page-footer"><a href="/">← Return to Avon Toastmasters</a><span>Avon Toastmasters · Webmaster</span></footer>
  </main>
</body>
</html>