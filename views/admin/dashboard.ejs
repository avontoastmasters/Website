<!doctype html>
<html lang="en-NZ"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><meta name="theme-color" content="#004165"><title>Webmaster Dashboard | Avon Toastmasters</title><link rel="stylesheet" href="/admin.css"><script src="/admin.js" defer></script></head>
<body class="admin-body"><main class="admin-shell">
<header class="admin-topbar"><a class="admin-brand" href="/"><span class="admin-brand__mark">AVON</span><span><strong>TOASTMASTERS</strong><small>WEBMASTER DASHBOARD</small></span></a><div class="admin-topbar__right"><span class="admin-user">Signed in as <strong><%= username %></strong></span><form method="post" action="/admin/logout"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="admin-logout" type="submit">Log out</button></form></div></header>
<section class="admin-heading"><p class="admin-eyebrow">AVON TOASTMASTERS · WEBSITE</p><h1>Announcement manager</h1><p class="admin-muted">Create and manage website banners. Save as many as you need, but only one can be live at a time.</p></section>
<% if (saved) { %><p class="admin-alert admin-alert--success" role="status">Changes saved successfully.</p><% } %>
<div class="admin-grid"><section class="admin-card"><div class="admin-card__heading"><div><h2><%= editing ? 'Edit announcement' : 'Create announcement' %></h2><p>Only the selected active banner appears on the public website.</p></div><span class="admin-lock">PRIVATE</span></div>
<form method="post" action="/admin/save" class="admin-form" id="announcement-form"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= editing ? editing.id : '' %>">
<label class="admin-toggle"><input type="checkbox" name="enabled" id="enabled" <%= editing ? (editing.enabled ? 'checked' : '') : 'checked' %>><span><strong>Publish this announcement</strong><small>Publishing it automatically turns off any other banner.</small></span></label>
<label for="type">Announcement style</label><select id="type" name="type"><option value="general" <%= editing && editing.type==='general'?'selected':'' %>>General – Loyal Blue</option><option value="important" <%= editing && editing.type==='important'?'selected':'' %>>Important – Happy Yellow</option><option value="event" <%= editing && editing.type==='event'?'selected':'' %>>Event – True Maroon</option><option value="urgent" <%= editing && editing.type==='urgent'?'selected':'' %>>Urgent – Red</option></select>
<label for="title">Heading</label><input id="title" name="title" maxlength="100" required value="<%= editing ? editing.title : '' %>" placeholder="e.g. Important meeting update">
<label for="message">Message</label><textarea id="message" name="message" rows="3" maxlength="500" required placeholder="Write a short message for website visitors..."><%= editing ? editing.message : '' %></textarea><small class="admin-help">Maximum 500 characters.</small>
<div class="admin-two-fields"><div><label for="buttonText">Button text <span>(optional)</span></label><input id="buttonText" name="buttonText" maxlength="40" value="<%= editing ? editing.buttonText : '' %>" placeholder="Find out more"></div><div><label for="buttonLink">Button link <span>(optional)</span></label><input id="buttonLink" name="buttonLink" maxlength="500" value="<%= editing ? editing.buttonLink : '' %>" placeholder="/meetings.html"></div></div>
<div class="admin-two-fields"><div><label for="startDate">Start date <span>(optional)</span></label><input id="startDate" name="startDate" type="date" value="<%= editing ? editing.startDate : '' %>"></div><div><label for="endDate">Expiry date <span>(optional)</span></label><input id="endDate" name="endDate" type="date" value="<%= editing ? editing.endDate : '' %>"></div></div><small class="admin-help">Dates use New Zealand time.</small>
<div class="admin-actions"><button class="admin-button" type="submit"><%= editing ? 'Save changes' : 'Save announcement' %> →</button><% if(editing){ %><a class="admin-secondary" href="/admin">Cancel edit</a><% } %><a class="admin-secondary" href="/" target="_blank" rel="noopener noreferrer">View website ↗</a></div></form></section>
<aside class="admin-preview-column"><section class="admin-card admin-preview-card"><p class="admin-eyebrow">LIVE PREVIEW</p><h2>How it will look</h2><p class="admin-muted">Preview updates as you type. Save to publish.</p><div id="announcement-preview" class="admin-preview site-announcement--general"><span id="preview-label" class="admin-preview__label">ANNOUNCEMENT</span><strong id="preview-title"><%= editing ? editing.title : 'Your announcement heading' %></strong><span id="preview-message"><%= editing ? editing.message : 'Your announcement message will appear here.' %></span><span id="preview-button" class="admin-preview__button" hidden>Find out more →</span></div><p class="admin-preview-note">The banner appears below the main navigation.</p></section></aside></div>
<section class="admin-card admin-list-card"><div class="admin-card__heading"><div><h2>Your announcements</h2><p><%= announcements.length %> saved · only one can be active on the website.</p></div></div>
<% if (!announcements.length) { %><p class="admin-empty">No announcements saved yet. Create your first banner above.</p><% } else { %><div class="admin-announcements"><% announcements.forEach(item => { const status = item.enabled ? 'Active' : (item.endDate && item.endDate < new Intl.DateTimeFormat('en-CA',{timeZone:'Pacific/Auckland'}).format(new Date()) ? 'Expired' : (item.startDate && item.startDate > new Intl.DateTimeFormat('en-CA',{timeZone:'Pacific/Auckland'}).format(new Date()) ? 'Scheduled' : 'Disabled')); %><article class="admin-announcement-row"><div class="admin-announcement-copy"><span class="admin-status admin-status--<%= status.toLowerCase() %>"><%= status %></span><h3><%= item.title %></h3><p><%= item.message %></p><small><%= item.startDate ? 'From '+item.startDate : 'No start date' %> · <%= item.endDate ? 'Until '+item.endDate : 'No expiry' %></small></div><div class="admin-row-actions"><a class="admin-secondary" href="/admin?edit=<%= encodeURIComponent(item.id) %>">Edit</a><form method="post" action="/admin/toggle"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= item.id %>"><input type="hidden" name="enabled" value="<%= item.enabled ? '' : 'on' %>"><button class="admin-small-button" type="submit"><%= item.enabled ? 'Disable' : 'Publish' %></button></form><form method="post" action="/admin/delete" onsubmit="return confirm('Delete this announcement permanently?')"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= item.id %>"><button class="admin-small-button admin-small-button--danger" type="submit">Delete</button></form></div></article><% }) %></div><% } %></section>
<footer class="admin-page-footer"><a href="/">← Return to Avon Toastmasters</a><span>Avon Toastmasters · Webmaster</span></footer></main></body></html>