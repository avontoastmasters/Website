<!doctype html>
<html lang="en-NZ"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><meta name="theme-color" content="#004165"><title>Event Manager | Avon Toastmasters</title><link rel="stylesheet" href="/admin.css"></head>
<body class="admin-body"><main class="admin-shell">
<header class="admin-topbar"><a class="admin-brand" href="/"><span class="admin-brand__mark">AVON</span><span><strong>TOASTMASTERS</strong><small>WEBMASTER DASHBOARD</small></span></a><div class="admin-topbar__right"><a class="admin-secondary" href="/admin">Announcements</a><a class="admin-secondary" href="/admin/media">Media library ↗</a><span class="admin-user">Signed in as <strong><%= username %></strong></span><form method="post" action="/admin/logout"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="admin-logout" type="submit">Log out</button></form></div></header>
<section class="admin-heading"><p class="admin-eyebrow">AVON TOASTMASTERS · WEBSITE</p><h1>Event manager</h1><p class="admin-muted">Publish club competitions, open evenings, workshops and social events. Published upcoming events appear on the public Events page.</p></section>
<% if (saved) { %><p class="admin-alert admin-alert--success" role="status">Event changes saved successfully.</p><% } %><% if (error) { %><p class="admin-alert admin-alert--error" role="alert"><%= error %></p><% } %>
<section class="admin-card"><div class="admin-card__heading"><div><h2><%= editing ? 'Edit event' : 'Create an event' %></h2><p>Complete the details below. All dates and times use New Zealand local time.</p></div><span class="admin-lock">PRIVATE</span></div>
<form method="post" action="/admin/events/save" class="admin-form"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= editing ? editing.id : '' %>">
<label class="admin-toggle"><input type="checkbox" name="enabled" <%= editing ? (editing.enabled ? 'checked' : '') : 'checked' %>><span><strong>Publish this event</strong><small>Published events appear on the public Events page. Unpublished events remain saved here.</small></span></label>
<label for="title">Event name</label><input id="title" name="title" maxlength="120" required value="<%= editing ? editing.title : '' %>" placeholder="e.g. Avon Toastmasters Speech Contest">
<label for="slug">Custom event URL <span>(optional)</span></label><div class="admin-slug-field"><span>toastmasters.net.nz/events/</span><input id="slug" name="slug" maxlength="80" pattern="[a-zA-Z0-9-]+" value="<%= editing ? (editing.slug || '') : '' %>" placeholder="avon-toastmasters-open-house"></div><small class="admin-help">Leave blank to generate a URL automatically from the event name. Use letters, numbers and hyphens.</small>
<label for="category">Event type</label><select id="category" name="category"><% const categories = [['competition','Speech competition'],['open-house','Open house'],['workshop','Workshop'],['social','Club social'],['special','Special event'],['other','Other club event']]; categories.forEach(option => { %><option value="<%= option[0] %>" <%= editing && editing.category===option[0]?'selected':'' %>><%= option[1] %></option><% }) %></select>
<label for="description">Description</label><textarea id="description" name="description" rows="4" maxlength="2000" required placeholder="Tell visitors what the event is about..."><%= editing ? editing.description : '' %></textarea><small class="admin-help">Maximum 2,000 characters.</small>
<div class="admin-two-fields"><div><label for="date">Event date</label><input id="date" name="date" type="date" required value="<%= editing ? editing.date : '' %>"></div><div><label for="location">Location</label><input id="location" name="location" maxlength="180" required value="<%= editing ? editing.location : 'St Albans Community Centre, 1049 Colombo Street, Christchurch' %>"></div></div>
<div class="admin-two-fields"><div><label for="startTime">Start time</label><input id="startTime" name="startTime" type="time" required value="<%= editing ? editing.startTime : '19:00' %>"></div><div><label for="endTime">Finish time <span>(optional)</span></label><input id="endTime" name="endTime" type="time" value="<%= editing ? editing.endTime : '' %>"></div></div>
<label for="imageUrl">Event image URL <span>(optional)</span></label><input id="imageUrl" name="imageUrl" maxlength="240" value="<%= editing ? (editing.imageUrl || '') : '' %>" placeholder="/uploads/media/your-image.webp"><small class="admin-help">Upload an image in the Media library, then paste its path here.</small>
<label for="bookingLink">More information / booking link <span>(optional)</span></label><input id="bookingLink" name="bookingLink" maxlength="500" value="<%= editing ? (editing.bookingLink || '') : '' %>" placeholder="https://... or /visit.html">
<div class="admin-actions"><button class="admin-button" type="submit"><%= editing ? 'Save event changes' : 'Create event' %> →</button><% if(editing){ %><a class="admin-secondary" href="/admin/events">Cancel edit</a><% } %><a class="admin-secondary" href="/events.html" target="_blank" rel="noopener noreferrer">View Events page ↗</a></div></form></section>
<section class="admin-card admin-list-card"><div class="admin-card__heading"><div><p class="admin-eyebrow">CONTENT LIBRARY</p><h2>Saved events</h2><p>Events stay here after they finish, so you can review, reuse or remove them.</p></div><span class="admin-lock"><%= events.length %> TOTAL</span></div>
<% if (!events.length) { %><p class="admin-empty">No events yet. Create your first event using the form above.</p><% } else { %><div class="admin-announcements"><% events.forEach(item => { const past = item.date < new Date().toLocaleDateString('en-CA',{timeZone:'Pacific/Auckland'}); %><article class="admin-announcement-row admin-announcement-card"><div class="admin-announcement-copy"><span class="admin-status admin-status--<%= item.enabled && !past ? 'active' : 'disabled' %>"><%= !item.enabled ? 'Unpublished' : (past ? 'Past event' : 'Published') %></span><h3><%= item.title %></h3><p><%= item.description.length > 180 ? item.description.slice(0, 180) + '…' : item.description %></p><small><%= item.date %> · <%= item.startTime %><%= item.endTime ? '–' + item.endTime : '' %> · <%= item.location %></small><p><a href="/events/<%= encodeURIComponent(item.slug || item.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')) %>" target="_blank" rel="noopener noreferrer">View public event page ↗</a></p></div><div class="admin-row-actions"><a class="admin-secondary" href="/admin/events?edit=<%= encodeURIComponent(item.id) %>">Edit</a><form method="post" action="/admin/events/toggle"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= item.id %>"><input type="hidden" name="enabled" value="<%= item.enabled ? '' : 'on' %>"><button class="admin-small-button" type="submit"><%= item.enabled ? 'Unpublish' : 'Publish' %></button></form><form method="post" action="/admin/events/delete" onsubmit="return confirm('Permanently delete this event? This cannot be undone.');"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= item.id %>"><button class="admin-small-button admin-small-button--danger" type="submit">Delete</button></form></div></article><% }) %></div><% } %></section>
<footer class="admin-page-footer"><a href="/admin">← Return to webmaster dashboard</a><span>Avon Toastmasters · Webmaster</span></footer></main></body></html>