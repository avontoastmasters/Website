<!doctype html>
<html lang="en-NZ">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <meta name="theme-color" content="#004165">
  <title>Forgot Password | Avon Toastmasters</title>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <link rel="stylesheet" href="/admin.css">
</head>
<body class="admin-body">
  <main class="admin-shell admin-shell--login">
    <a class="admin-brand" href="/" aria-label="Avon Toastmasters home">
      <span class="admin-brand__mark">AVON</span>
      <span><strong>TOASTMASTERS</strong><small>WEBSITE ADMINISTRATION</small></span>
    </a>
    <section class="admin-card">
      <p class="admin-eyebrow">ACCOUNT RECOVERY</p>
      <h1>Forgot your password?</h1>
      <p class="admin-muted">Enter the email address associated with your administrator account. If an eligible account exists, we'll send a password reset link.</p>
      <% if (sent) { %>
        <p class="admin-alert" role="status">If an account is registered with that email address, a password reset link will be sent. Please check your inbox.</p>
      <% } %>
      <% if (error) { %><p class="admin-alert admin-alert--error" role="alert"><%= error %></p><% } %>
      <form method="post" action="/admin/forgot-password" class="admin-form">
        <label for="email">Email address</label>
        <input id="email" name="email" type="email" autocomplete="email" maxlength="254" required>
        <div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>" data-action="admin_recovery"></div>
        <button class="admin-button" type="submit">Send reset link <span aria-hidden="true">→</span></button>
      </form>
      <a class="admin-back-link" href="/admin">← Back to sign in</a>
    </section>
    <p class="admin-footer">Avon Toastmasters · Christchurch, New Zealand</p>
  </main>
</body>
</html>
